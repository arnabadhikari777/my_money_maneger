# Copy to .env locally, or set these as real environment variables on PythonAnywhere
# (Web tab -> WSGI configuration file, or a .env loaded there).

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///instance/moneymanager.db
SESSION_COOKIE_SECURE=1

# Web Push (optional - needed for the "every few hours" reminders).
# Generate with: vapid --gen  (from the py-vapid package)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

# Shared secret for the scheduled reminder endpoint (make up a long random string)
CRON_SECRET=replace-with-a-long-random-string
